---
import Base from '../../../layouts/Base.astro';
import ArticleList from '../../../components/ArticleList.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import { CATEGORIES, CATEGORY_LEADS, CATEGORY_SLUGS } from '../../../consts';
import { getPublishedArticles } from '../../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return CATEGORIES.map((category) => ({
    params: { category: CATEGORY_SLUGS[category] },
    props: { category, articles: articles.filter((a) => a.data.category === category) },
  }));
}

const { category, articles } = Astro.props;
---

<Base title={category} current="articles" description={`鈴音神楽の「${category}」。${CATEGORY_LEADS[category]}`}>
  <div class="page">
    <h1 class="page-title">{category}</h1>
    <p class="page-lead">{CATEGORY_LEADS[category]}</p>
    <CategoryNav current={category} />
    <ArticleList articles={articles} />
  </div>
</Base>
