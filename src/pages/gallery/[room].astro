---
import Base from '../../layouts/Base.astro';
import { formatDate, href } from '../../consts';
import { fullOf, getExhibits, roomName, roomPath, type Photo } from '../../lib/photos';

export async function getStaticPaths() {
  const exhibits = await getExhibits();
  return exhibits.map((photo, i) => ({
    params: { room: String(photo.data.room) },
    props: { photo, prev: exhibits[i - 1], next: exhibits[i + 1] },
  }));
}

interface Props {
  photo: Photo;
  prev?: Photo;
  next?: Photo;
}

const { photo, prev, next } = Astro.props;
const { room, comment, name, x, width, height, alt, date } = photo.data;
const title = roomName(room!);
---

<Base title={`${title}｜写真館`} current="gallery" description={comment ?? `鈴音神楽の写真館 ${title}`}>
  <div class="page">
    <p class="crumb"><a href={href('/gallery/')}>写真館</a></p>
    <h1 class="page-title">{title}</h1>

    <figure class="frame">
      <img src={fullOf(photo)} alt={alt} width={width} height={height} decoding="async" />
    </figure>

    <div class="card">
      {comment && <p class="comment">{comment}</p>}
      <dl class="meta">
        {
          name && (
            <div>
              <dt>提供</dt>
              <dd>{name}</dd>
            </div>
          )
        }
        <div>
          <dt>展示</dt>
          <dd>{formatDate(date)}</dd>
        </div>
      </dl>
      {
        x && (
          <p class="xlink">
            <a class="button ghost" href={x} target="_blank" rel="noopener noreferrer nofollow">
              Xを見る
            </a>
          </p>
        )
      }
    </div>

    <nav class="rooms" aria-label="ほかの展示室">
      {prev ? <a href={href(roomPath(prev.data.room!))}>← {roomName(prev.data.room!)}</a> : <span />}
      <a href={href('/gallery/')}>写真館へ戻る</a>
      {next ? <a href={href(roomPath(next.data.room!))}>{roomName(next.data.room!)} →</a> : <span />}
    </nav>
  </div>
</Base>

<style>
  .crumb {
    margin: 2rem 0 -2rem;
    font-size: 0.9rem;
  }

  /* 金の額縁に入れて飾る */
  .frame {
    margin: 2rem 0 0;
    padding: clamp(0.5rem, 1.5vw, 0.9rem);
    background: #fffaf4;
    border: 4px solid var(--kin);
    box-shadow:
      0 0 0 6px var(--ki),
      0 14px 30px rgba(49, 34, 27, 0.35);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 78vh;
    object-fit: contain;
  }

  .card {
    max-width: var(--measure);
    margin: 2.5rem auto 0;
    text-align: center;
  }
  .comment {
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: clamp(1.05rem, 3vw, 1.25rem);
    line-height: 2;
    margin: 0 0 1.5rem;
    white-space: pre-line;
  }
  .meta {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.5rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--sumi-soft);
  }
  .meta div {
    display: flex;
    gap: 0.5rem;
  }
  .meta dt {
    color: var(--beni);
    font-weight: 700;
  }
  .meta dd {
    margin: 0;
  }
  .xlink {
    margin: 1.5rem 0 0;
  }
  .xlink .button {
    color: var(--sumi);
    min-height: 2.6rem;
  }

  .rooms {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    margin: 3.5rem 0 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--washi-deep);
    font-size: 0.95rem;
  }
  .rooms > :last-child {
    text-align: right;
  }
  @media (max-width: 30rem) {
    .rooms {
      grid-template-columns: 1fr 1fr;
    }
    .rooms > :nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
      text-align: center;
    }
  }
</style>
