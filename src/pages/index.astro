---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { SITE, href } from '../consts';
import { getPublishedArticles } from '../lib/articles';
import { getPhotos, thumbOf } from '../lib/photos';

const latest = (await getPublishedArticles()).slice(0, 3);
/** ホームの背景に敷く写真の候補（写真館の写真すべて）。並びは開くたびに変わる */
const allPhotos = (await getPhotos()).map(thumbOf);
/** 写真がこの枚数に届くまでは背景を敷かない（同じ写真ばかり並んで見えるため） */
const BACKDROP_MIN_PHOTOS = 4;
const backdropPool = allPhotos.length >= BACKDROP_MIN_PHOTOS ? allPhotos : [];
/** 背景のマス目の数。写真が少なければ同じ写真をくり返して埋める */
const BACKDROP_TILES = 24;
---

<Base>
  <section class="hero wood" aria-labelledby="hero-title">
    {
      backdropPool.length > 0 && (
        <div class="backdrop" aria-hidden="true" data-pool={JSON.stringify(backdropPool)}>
          {Array.from({ length: BACKDROP_TILES }, (_, i) => (
            <img src={backdropPool[i % backdropPool.length]} alt="" width="640" height="480" decoding="async" />
          ))}
        </div>
      )
    }
    <div class="hero-inner">
      <img
        class="emblem"
        src={href('/images/emblem.webp')}
        alt="鈴音神楽のギルド紋。桜と鳥居、川を行く舟、神楽紐の付いた鈴が描かれている"
        width="720"
        height="720"
      />
      <div class="hero-text">
        <h1 id="hero-title" class="vertical-title">鈴音神楽</h1>
        <p class="vertical-sub">{SITE.server}のギルド</p>
      </div>
    </div>
    <div class="hero-foot">
      <p class="lead">
        忙しい日はオートでゆるく、新コンテンツはみんなで本気で。<br />
        戦闘力は問いません。初心者さんも大歓迎です。
      </p>
      <div class="actions">
        <a class="button" href={href('/about/')}>ギルドについて</a>
        <a class="button ghost" href={href('/articles/')}>記事を読む</a>
      </div>
    </div>
  </section>

  <script>
    // 開くたびに背景の写真の並びを変える（同じ写真が隣り合いにくいように、混ぜた順でくり返す）
    const backdrop = document.querySelector<HTMLElement>('.backdrop');
    if (backdrop?.dataset.pool) {
      const pool: string[] = JSON.parse(backdrop.dataset.pool);
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j]!, pool[i]!];
      }
      backdrop.querySelectorAll('img').forEach((img, i) => {
        img.src = pool[i % pool.length]!;
      });
    }
  </script>

  <div class="page">
    <section aria-labelledby="facts-title">
      <h2 id="facts-title" class="section-title">ギルドのようす</h2>
      <dl class="facts">
        <div>
          <dt>サーバー</dt>
          <dd>{SITE.server}</dd>
        </div>
        <div>
          <dt>雰囲気</dt>
          <dd>ガチすぎず、アビスやレイドは積極的に</dd>
        </div>
        <div>
          <dt>参加の条件</dt>
          <dd>戦闘力不問。毎日ログインと、ときどきのひとことを</dd>
        </div>
        <div>
          <dt>みんなで</dt>
          <dd>ギルド艦船に向けて製作・採集の素材を集めています</dd>
        </div>
        <div>
          <dt>連絡</dt>
          <dd>Discordで情報共有・パーティ募集・お知らせ</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="latest-title">
      <h2 id="latest-title" class="section-title">新しい記事</h2>
      <ArticleList articles={latest} />
      <p class="more"><a href={href('/articles/')}>記事をすべて見る</a></p>
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    border-bottom: 3px solid var(--kin);
    padding: 2.5rem var(--gutter) 2.5rem;
    overflow: hidden;
  }
  /* 背景に、暗くしたメンバーの写真を敷く */
  .backdrop {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(9rem, 20vw, 16rem), 1fr));
    align-content: start;
    gap: 4px;
    opacity: 0.22;
    filter: sepia(0.35);
    overflow: hidden;
    pointer-events: none;
  }
  .backdrop img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .hero-inner,
  .hero-foot {
    position: relative;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 5vw, 3.5rem);
    max-width: 46rem;
    margin-inline: auto;
  }
  .emblem {
    flex: none;
    width: min(56vw, 22rem);
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));
  }

  /* 紅の神楽紐が上から垂れ、その横に縦書きのギルド名 */
  .hero-text {
    flex: none;
    position: relative;
    display: flex;
    gap: 0.6rem;
    padding-top: 1.5rem;
    align-self: stretch;
    align-items: flex-start;
  }
  .hero-text::before {
    content: '';
    position: absolute;
    top: -2.5rem;
    right: -0.9rem;
    width: 4px;
    height: calc(100% + 2.5rem);
    background: linear-gradient(180deg, var(--beni) 80%, transparent);
    border-radius: 2px;
  }
  .vertical-title {
    writing-mode: vertical-rl;
    white-space: nowrap;
    text-wrap: nowrap;
    font-weight: 800;
    font-size: clamp(2.6rem, 9vw, 4.5rem);
    letter-spacing: 0.25em;
    line-height: 1;
    color: var(--washi);
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
  }
  .vertical-sub {
    writing-mode: vertical-rl;
    white-space: nowrap;
    margin: 0.4rem 0 0;
    font-family: var(--font-mincho);
    font-size: clamp(0.85rem, 2.6vw, 1rem);
    letter-spacing: 0.3em;
    color: var(--kin-light);
  }

  .hero-foot {
    max-width: 46rem;
    margin: 2rem auto 0;
    text-align: center;
  }
  .lead {
    word-break: auto-phrase;
    text-wrap: balance;
    font-family: var(--font-mincho);
    font-weight: 500;
    font-size: clamp(1rem, 3.2vw, 1.15rem);
    line-height: 2;
    margin: 0 0 1.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .facts {
    margin: 0;
    max-width: 44rem;
  }
  .facts div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--washi-deep);
  }
  .facts div:first-child {
    border-top: 1px solid var(--washi-deep);
  }
  dt {
    font-family: var(--font-mincho);
    font-weight: 700;
    color: var(--beni);
  }
  dd {
    margin: 0;
  }
  .more {
    margin-top: 1.25rem;
  }

  @media (max-width: 30rem) {
    .facts div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
