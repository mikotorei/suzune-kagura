---
import '@fontsource/shippori-mincho-b1/500.css';
import '@fontsource/shippori-mincho-b1/700.css';
import '@fontsource/shippori-mincho-b1/800.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '../styles/global.css';
import { SITE, href } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** ナビで今いる場所を示す */
  current?: 'about' | 'join' | 'articles' | 'aikotoba';
}

const { title, description = SITE.description, current } = Astro.props;
const pageTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜マビノギモバイル ギルド`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('/images/og.jpg'), Astro.site);

const nav = [
  { key: 'about', label: 'ギルドについて', path: '/about/' },
  { key: 'join', label: '参加方法', path: '/join/' },
  { key: 'articles', label: '記事', path: '/articles/' },
  { key: 'aikotoba', label: '合言葉', path: '/aikotoba/' },
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="icon" href={href('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#31221b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>

    <header class="site-header wood">
      <div class="bar">
        <a class="brand" href={href('/')}>
          <img src={href('/images/emblem-small.webp')} alt="" width="40" height="40" />
          <span>鈴音神楽</span>
        </a>
        <nav aria-label="サイト内">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={href(item.path)} aria-current={current === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wood">
      <div class="footer-inner">
        <p class="footer-name">鈴音神楽<span>{SITE.server}サーバー</span></p>
        <p class="notice">
          当サイトは、マビノギモバイルのプレイヤーが運営する非公式のファンサイトです。株式会社ネクソンおよび公式とは関係ありません。
          ゲームの内容に関する最新情報は<a href="https://mabinogimobile.nexon.co.jp/" rel="noopener">マビノギモバイル公式サイト</a>をご確認ください。
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: relative;
    border-bottom: 3px solid var(--kin);
  }
  .bar {
    width: min(100% - var(--gutter) * 2, 60rem);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: 0.6rem 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--washi);
    text-decoration: none;
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.12em;
  }
  .brand:hover {
    color: var(--washi);
    text-decoration: none;
  }
  .brand img {
    width: 40px;
    height: 40px;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }
  nav a {
    display: block;
    color: var(--washi);
    text-decoration: none;
    font-size: 0.92rem;
    padding: 0.35rem 0;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--kin-light);
  }
  nav a[aria-current='page'] {
    border-bottom-color: var(--beni);
    color: var(--kin-light);
  }

  main {
    padding-bottom: 5rem;
  }

  .site-footer {
    border-top: 3px solid var(--kin);
  }
  .footer-inner {
    width: min(100% - var(--gutter) * 2, 60rem);
    margin-inline: auto;
    padding: 2rem 0 2.5rem;
  }
  .footer-name {
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    margin: 0 0 0.75rem;
  }
  .footer-name span {
    font-family: var(--font-gothic);
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    margin-left: 0.75rem;
    color: var(--kin-light);
  }
  .notice {
    font-size: 0.8rem;
    line-height: 1.8;
    color: #d9c9bb;
    max-width: 42rem;
    margin: 0;
  }
  .notice a {
    color: var(--kin-light);
  }
</style>
