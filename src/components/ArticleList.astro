---
import type { CollectionEntry } from 'astro:content';
import { categoryHref, formatDate, href } from '../consts';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
---

{
  articles.length === 0 ? (
    <p class="empty">まだ記事がありません。最初の一本をお待ちしています。</p>
  ) : (
    <ul class="list">
      {articles.map((article) => (
        <li>
          <article>
            <div class="meta">
              <a class="tag" href={categoryHref(article.data.category)}>
                {article.data.category}
              </a>
              <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
            </div>
            <h3>
              <a href={href(`/articles/${article.id}/`)}>{article.data.title}</a>
            </h3>
            {article.data.description && <p>{article.data.description}</p>}
          </article>
        </li>
      ))}
    </ul>
  )
}

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--washi-deep);
  }
  li {
    border-bottom: 1px solid var(--washi-deep);
    padding: 1.25rem 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--sumi-soft);
  }
  h3 {
    font-size: 1.2rem;
    margin: 0.4rem 0 0.2rem;
  }
  h3 a {
    color: var(--sumi);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--beni);
    text-decoration: underline;
  }
  p {
    margin: 0;
    color: var(--sumi-soft);
    font-size: 0.95rem;
    max-width: var(--measure);
  }
  .empty {
    color: var(--sumi-soft);
  }
</style>
